function Strings.langFromLocale(locale: string?): string
	if type(locale) == "string" and string.sub(string.lower(locale), 1, 2) == "ru" then
		return "ru"
	end
	return "en"
end

function Strings.get(lang: string, key: string, vars: { [string]: any }?): string
	local tbl = Strings[lang] or Strings.en
	local s = tbl[key] or Strings.en[key] or key
	if vars then
		s = string.gsub(s, "{(%w+)}", function(name)
			local v = vars[name]
			if v == nil then
				return "{" .. name .. "}"
			end
			if type(v) == "string" and tbl[v] then
				return tbl[v]
			end
			return tostring(v)
		end)
	end
	return s
end

-- 154.3 → "2:34"
function Strings.formatTime(sec: number): string
	sec = math.max(0, math.floor(sec + 0.5))
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

return Strings
